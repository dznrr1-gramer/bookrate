# Local PostgreSQL connection. Replace the development password in your local .env.
DATABASE_URL="postgresql://bookrate_dev:change-me@localhost:5432/bookrate?schema=public"

# Server configuration. Defaults are suitable for local development.
API_PORT=4000
WEB_ORIGIN="http://localhost:3000"
NEXT_PUBLIC_API_URL="http://localhost:4000/api/v1"

# Set a random value of at least 32 characters for production.
# Development generates an ephemeral key if this is unset.
AUTH_JWT_SECRET=

# Optional development-only admin seed. Set both values in .env to create an admin.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# Optional; keep provider credentials server-side only.
# GOOGLE_BOOKS_API_KEY=
