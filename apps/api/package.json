{
  "name": "api",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "dev": "bun --watch src/main.ts",
    "build": "bun build src/main.ts --target=bun --packages=external --outdir=dist",
    "start": "bun dist/main.js",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "bun test"
  },
  "dependencies": {
    "@bookrate/config": "workspace:*",
    "@bookrate/database": "workspace:*",
    "@bookrate/types": "workspace:*",
    "@bookrate/validators": "workspace:*",
    "@nestjs/common": "^11.1.6",
    "@nestjs/core": "^11.1.6",
    "@nestjs/jwt": "^11.0.1",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.1.6",
    "@nestjs/swagger": "^11.2.0",
    "dotenv": "^16.6.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@nestjs/testing": "^11.1.6",
    "@types/bun": "^1.3.8",
    "@types/express": "^5.0.3",
    "@types/node": "^20.19.17",
    "@types/passport-jwt": "^4.0.1",
    "eslint": "^9.36.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.44.1"
  }
}
